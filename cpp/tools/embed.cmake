# Embeds text files into C++ as std::string_view constants.
# cmake -DOUT_HEADER=... -DOUT_SOURCE=... -DINPUTS="name=path;name=path" -P embed.cmake
set(header "// Generated by tools/embed.cmake. Do not edit.\n#pragma once\n#include <string_view>\nnamespace skeuo::assets {\n")
set(source "// Generated by tools/embed.cmake. Do not edit.\n#include \"assets.hpp\"\nnamespace skeuo::assets {\n")
foreach(entry IN LISTS INPUTS)
  string(REPLACE "=" ";" parts "${entry}")
  list(GET parts 0 name)
  list(GET parts 1 path)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" hex_len)
  math(EXPR size "${hex_len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," bytes "${hex}")
  string(APPEND header "extern const std::string_view ${name};\n")
  string(APPEND source "static const char ${name}_data[] = {${bytes}0};\nconst std::string_view ${name}(${name}_data, ${size});\n")
endforeach()
string(APPEND header "}  // namespace skeuo::assets\n")
string(APPEND source "}  // namespace skeuo::assets\n")
file(WRITE "${OUT_HEADER}" "${header}")
file(WRITE "${OUT_SOURCE}" "${source}")
